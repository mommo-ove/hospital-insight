# Copy to .env. The default demo parser runs locally and is explicitly labelled.
LLM_MODE=demo
# To use a real model, set LLM_MODE=cloud and fill in all three values below.
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Optional. Relative paths are resolved against the project root.
DATABASE_PATH=data/hospital.db
# Defaults to the original workbook in this folder. Set to "none" to start empty.
SEED_EXCEL=院管数据.xlsx

